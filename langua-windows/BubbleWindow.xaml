<Window x:Class="LanguaWin.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">
    <Border x:Name="Bubble"
            Background="#E6070710"
            BorderBrush="#597EF8FA"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>
        <TextBlock x:Name="PinyinText"
                   FontFamily="Segoe UI, Microsoft YaHei"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#7EE8FA"
                   LetterSpacing="1"
                   TextWrapping="NoWrap"/>
    </Border>
</Window>
